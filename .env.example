# =========================================================================
# CinéPulse Bharat - Environment Variables Configuration Template
# =========================================================================

# [MANDATORY] Application runtime environment: 'development', 'staging', or 'production'
# Used by Worker logging, cache controls, and telemetry adapters.
APP_ENV=production

# [MANDATORY] Canonical public website URL (Used for sitemaps, OpenGraph meta, and RSS)
PUBLIC_SITE_URL=https://cinepulse.in

# [MANDATORY] Base path or origin for the Cloudflare Workers REST API
API_BASE_URL=/api/v1

# [OPTIONAL] TMDB API Bearer or v3 Key for international metadata backfill
# Required only if executing remote TMDB candidate discovery adapter.
TMDB_API_KEY=your_tmdb_api_key_here

# [MANDATORY FOR ADMIN] Secret Bearer token for protected administration routes (/api/v1/admin/*)
# Configure in Cloudflare using: npx wrangler secret put ADMIN_API_KEY
ADMIN_API_KEY=cinepulse-admin-secret-2026

# [MANDATORY] Allowlists for server-side URL retrieval (SSRF protection)
# Only domains listed here can be pinged by automated source health monitors.
ALLOWED_SOURCE_DOMAINS=en.wikipedia.org,in.bookmyshow.com,newindianmovies.com,varietyindia.com,district.in,sacnilk.com

# [OPTIONAL] Logging granularity: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info

# [OPTIONAL] Default Indian Standard Time (IST) date anchor (YYYY-MM-DD)
# Defaults to dynamic live date if left empty.
DEFAULT_IST_DATE_ANCHOR=2026-10-21
